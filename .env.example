NODE_ENV=development
# Render's Environment must select NODE_VERSION=22; .node-version also pins the major.
PORT=3000
APP_BASE_URL=http://localhost:3000
# Render production: use the real public HTTPS origin, never localhost.
# APP_URL is not used. Render's RENDER_EXTERNAL_URL is a fallback if APP_BASE_URL is absent.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional direct migration URL; Neon pooler URLs are converted automatically.
DIRECT_DATABASE_URL=
# Optional migration bounds in milliseconds. Defaults shown; do not use zero to disable checks.
# MIGRATION_CONNECT_TIMEOUT_MS=30000
# MIGRATION_LOCK_TIMEOUT_MS=15000
# MIGRATION_STATEMENT_TIMEOUT_MS=60000
# MIGRATION_TIMEOUT_MS=90000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/remarket
SESSION_SECRET=replace-with-at-least-32-random-characters
# Preferred on Render: HTTPS email delivery (provider sender verification required)\nBREVO_API_KEY=\nRESEND_API_KEY=\n# SMTP fallback when RESEND_API_KEY is empty\nSMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM=Sherubtse ReMarket <noreply@example.com>
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
ALLOWED_EMAIL_DOMAIN=
TEST_DATABASE_URL=

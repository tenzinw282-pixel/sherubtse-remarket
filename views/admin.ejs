<%- include('partials/header') %>
<div class="admin-layout"><aside class="surface admin-sidebar"><p class="eyebrow">Management</p><nav aria-label="Administration"><% for(const [key,label] of [['overview','Overview'],['users','Students'],['approvals','Product approvals'],['products','All listings'],['auctions','Auctions'],['transactions','Transactions'],['reports','Reports'],['categories','Categories'],['announcements','Announcements'],['audit','Audit logs']]){ %><a href="/admin<%= key==='overview'?'':'/'+key %>" <%- section===key?'aria-current="page"':'' %>><%= label %></a><% } %></nav></aside>
<section class="admin-main"><div class="page-heading"><p class="eyebrow">Sherubtse ReMarket</p><h1 class="text-capitalize"><%= section==='overview'?'Platform overview':section %></h1><p>Verified administrator: <%= currentUser.full_name %>. Every moderation decision requires a reason.</p></div>
<% if(section==='overview'){ %><div class="stat-grid"><% for(const [key,label] of [['users','Total users'],['verified','Verified users'],['suspended','Suspended users'],['active','Available listings'],['sold','Sold products'],['pending','Pending review'],['auctions','Open auctions'],['completed','Completed transactions'],['reports','Open reports']]){ %><div class="surface stat-card"><span><%= label %></span><strong><%= stats[key] || 0 %></strong></div><% } %></div><a href="/admin/approvals" class="btn btn-primary mt-4">Review pending products</a><% }else{ %>
<% if(['users','products'].includes(section)){ %><form class="button-row mb-4" method="get"><label for="admin-search" class="visually-hidden">Search <%= section %></label><input class="form-control bid-input" id="admin-search" name="q" value="<%= q %>" placeholder="Search <%= section %>"><% if(section==='users'){ %><label class="visually-hidden" for="filter">User status</label><select class="form-select bid-input" id="filter" name="filter"><option value="">All users</option><option value="suspended">Suspended</option><option value="unverified">Unverified</option></select><% } %><button class="btn btn-primary">Search</button></form><% } %>
<% if(section==='categories'){ %><form method="post" action="/admin/categories" class="surface p-4 mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="new-category" class="form-label">New category name</label><input id="new-category" name="name" class="form-control mb-3" required minlength="2" maxlength="80"><button class="btn btn-primary">Add category</button></form><% } %>
<% if(section==='announcements'){ %><form method="post" action="/admin/announcements" class="surface p-4 mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="new-title" class="form-label">Announcement title</label><input id="new-title" name="title" class="form-control mb-3" required minlength="3" maxlength="160"><label for="new-body" class="form-label">Announcement</label><textarea id="new-body" name="body" class="form-control mb-3" required minlength="3" maxlength="4000"></textarea><button class="btn btn-primary">Publish announcement</button></form><% } %>
<% if(!rows.length){ %><div class="empty-state surface"><h2 class="h5">Nothing to review</h2><p>Matching database records will appear here.</p></div><% } %>
<% for(const row of rows){ %><article class="surface p-4 mb-3">
<% if(section==='users'){ %><h2 class="h5"><a href="/users/<%= row.id %>"><%= row.full_name %></a></h2><p><%= row.email %> &middot; <%= row.role %> &middot; <%= row.email_verified_at?'Email verified':'Unverified' %> &middot; <%= row.suspended_at?'Suspended':'Active' %></p><form method="post" action="/admin/users/<%= row.id %>/<%= row.suspended_at?'reactivate':'suspend' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="reason-<%= row.id %>">Reason</label><input class="form-control mb-3" id="reason-<%= row.id %>" name="reason" minlength="3" maxlength="2000" required><button class="btn btn-outline-secondary"><%= row.suspended_at?'Reactivate':'Suspend' %> account</button></form>
<% }else if(['approvals','products'].includes(section)){ %><h2 class="h5"><a href="/products/<%= row.id %>"><%= row.title %></a></h2><p><%= row.seller_name %> &middot; Nu. <%= row.price %> &middot; <%= row.selling_type %> &middot; <%= row.moderation_status %> / <%= row.status %></p>
<form method="post" action="/admin/products/<%= row.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="reason-<%= row.id %>">Moderation reason</label><input class="form-control mb-3" id="reason-<%= row.id %>" name="reason" required minlength="3" maxlength="2000"><div class="button-row"><% if(row.moderation_status==='pending'){ %><button class="btn btn-primary">Approve</button><button class="btn btn-outline-secondary" formaction="/admin/products/<%= row.id %>/reject">Reject</button><% } %><button class="btn btn-outline-secondary" formaction="/admin/products/<%= row.id %>/<%= row.status==='removed'?'restore':'remove' %>"><%= row.status==='removed'?'Restore eligible listing':'Remove listing' %></button><% if(row.moderation_status==='approved'){ %><button class="btn btn-outline-secondary" formaction="/admin/products/<%= row.id %>/feature-toggle"><%= row.featured?'Unfeature':'Feature' %></button><% } %></div></form>
<% }else if(section==='auctions'){ %><h2 class="h5"><a href="/products/<%= row.product_id %>"><%= row.title %></a></h2><p><%= row.status %> &middot; <%= row.moderation_status %> &middot; <%= row.bid_count %> bids &middot; Ends <%= new Date(row.ends_at).toISOString() %></p><a href="/products/<%= row.product_id %>">Inspect bidding history</a><% if(row.status==='open'){ %><form class="mt-3" method="post" action="/admin/auctions/<%= row.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="reason-<%= row.id %>">Cancellation reason</label><input class="form-control mb-3" id="reason-<%= row.id %>" name="reason" minlength="3" maxlength="2000" required><button class="btn btn-outline-secondary">Cancel and hide auction</button></form><% } %>
<% }else if(section==='transactions'){ %><h2 class="h5"><%= row.title %></h2><p>Nu. <%= row.amount %> &middot; <%= row.status %> &middot; <code><%= row.id %></code></p><% if(row.status==='disputed'){ %><form method="post" action="/admin/transactions/<%= row.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="decision-<%= row.id %>">Decision</label><select class="form-select mb-3" name="decision" id="decision-<%= row.id %>"><option value="resume">Resume transaction</option><option value="cancel">Cancel and remove listing</option></select><label class="form-label" for="reason-<%= row.id %>">Decision reason</label><input class="form-control mb-3" name="reason" id="reason-<%= row.id %>" minlength="3" maxlength="2000" required><button class="btn btn-primary">Record decision</button></form><% } %>
<% }else if(section==='reports'){ %><h2 class="h5"><a href="/products/<%= row.product_id %>"><%= row.title %></a></h2><p><%= row.reason %></p><span class="status-badge"><%= row.status %></span><% if(row.status==='open'){ %><form class="mt-3" method="post" action="/admin/reports/<%= row.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="decision-<%= row.id %>">Decision</label><select class="form-select mb-3" name="decision" id="decision-<%= row.id %>"><option value="resolved">Resolved</option><option value="dismissed">Dismissed</option></select><label class="form-label" for="reason-<%= row.id %>">Decision reason</label><input class="form-control mb-3" id="reason-<%= row.id %>" name="reason" minlength="3" maxlength="2000" required><button class="btn btn-primary">Save decision</button></form><% } %>
<% }else if(section==='categories'){ %><form method="post" action="/admin/categories/<%= row.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="category-<%= row.id %>" class="form-label">Category name</label><input id="category-<%= row.id %>" name="name" value="<%= row.name %>" class="form-control mb-3" required maxlength="80"><label class="terms-check"><input type="checkbox" name="active" <%= row.active?'checked':'' %>><span>Available for new listings</span></label><button class="btn btn-outline-secondary">Save category</button></form>
<% }else if(section==='announcements'){ %><h2 class="h5"><%= row.title %></h2><p><%= row.body %></p><span class="status-badge"><%= row.active?'Published':'Hidden' %></span><% if(row.active){ %><form class="mt-3" method="post" action="/admin/announcements/<%= row.id %>/hide"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">Hide announcement</button></form><% } %>
<% }else if(section==='audit'){ %><h2 class="h5"><%= row.action %></h2><p>By <%= row.full_name %> &middot; <%= new Date(row.created_at).toISOString() %></p><p class="text-break"><%= row.details.reason || '' %></p><p class="small text-break mb-0">Target: <%= row.target_id || 'Platform setting' %></p><% } %>
</article><% } %><% } %></section></div><%- include('partials/footer') %>

<%- include('partials/header') %><%- include('partials/workspace-nav') %>
<div class="page-heading"><p class="eyebrow">One account. Every possibility.</p><h1 class="text-capitalize"><%= title %></h1><p>Welcome, <%= currentUser.full_name %>. Manage everything you buy and sell in one place.</p></div>
<div class="stat-grid mb-4"><% for(const [key,label] of [['listings','Total listings'],['active','Active listings'],['sold','Sold products'],['bids','Active bid auctions'],['won','Auctions won']]){ %><div class="surface stat-card"><span><%= label %></span><strong><%= stats[key] || 0 %></strong></div><% } %></div>
<% if(['overview','listings','favorites'].includes(section)){ %><div class="section-title"><h2><%= section==='favorites'?'Saved items':'Your listings' %></h2><a class="btn btn-primary" href="/sell">List an item</a></div>
<% if(products.length){ %><div class="table-responsive surface"><table class="table mb-0"><thead><tr><th>Listing</th><th>Price</th><th>Status</th><th>Review</th><th>Actions</th></tr></thead><tbody><% for(const p of products){ %><tr><td><a href="/products/<%= p.id %>"><%= p.title %></a><% if(p.moderation_reason){ %><p class="small mb-0"><%= p.moderation_reason %></p><% } %></td><td>Nu. <%= p.price %></td><td><%= p.status %></td><td><%= p.moderation_status %></td><td><% if(p.seller_id===currentUser.id){ %><a href="/products/<%= p.id %>/edit">Edit</a><form method="post" action="/products/<%= p.id %>/withdraw" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">Withdraw</button></form><% }else{ %><a href="/products/<%= p.id %>">View</a><% } %></td></tr><% } %></tbody></table></div><% }else{ %><div class="empty-state surface"><h3>No items yet</h3><p>Your listings and saved products appear here as you use the marketplace.</p><a href="/marketplace">Explore marketplace</a></div><% } %><% } %>
<% if(['purchases','sales','won-auctions'].includes(section)){ %><p>Arrange payment outside the website. The seller confirms handover, then the buyer confirms receipt. Never share payment credentials here.</p>
<% if(!sales.length){ %><div class="empty-state surface"><h3>No transactions yet</h3><p>Purchases and completed auctions will appear here.</p><a href="/marketplace">Find an item</a></div><% } %>
<% for(const sale of sales){ %><article class="surface p-4 mb-3"><div class="section-title"><h2 class="h5"><a href="/products/<%= sale.product_id %>"><%= sale.title %></a></h2><span class="status-badge"><%= sale.status %></span></div><p>Nu. <%= sale.amount %> &middot; With <%= sale.counterpart %></p><div class="button-row">
<% if(!['completed','cancelled','disputed'].includes(sale.status)){ %><% const actions=currentUser.id===sale.seller_id?['handover','cancel','dispute']:['receive','cancel','dispute'];for(const action of actions){ %><form method="post" action="/transactions/<%= sale.id %>/<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary"><%= action==='handover'?'Confirm handover':action==='receive'?'Confirm receipt':action %></button></form><% } %><% } %>
<form method="post" action="/products/<%= sale.product_id %>/contact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="recipientId" value="<%= currentUser.id===sale.seller_id?sale.buyer_id:sale.seller_id %>"><button class="btn btn-primary">Contact <%= currentUser.id===sale.seller_id?'buyer':'seller' %></button></form></div>
<% if(sale.status==='completed'){ %><form method="post" action="/transactions/<%= sale.id %>/review" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="rating-<%= sale.id %>">Transaction rating</label><select id="rating-<%= sale.id %>" name="rating" class="form-select mb-2"><% for(const n of [5,4,3,2,1]){ %><option value="<%= n %>"><%= n %> / 5</option><% } %></select><label for="review-<%= sale.id %>" class="form-label">Review</label><input class="form-control mb-2" id="review-<%= sale.id %>" name="comment" required maxlength="2000"><button class="btn btn-outline-secondary">Save review</button></form><% } %></article><% } %><% } %>
<% if(section==='bids'){ %><div class="table-responsive surface"><table class="table mb-0"><thead><tr><th>Item</th><th>Your bid</th><th>Status</th><th>Placed</th></tr></thead><tbody><% for(const bid of bids){ %><tr><td><a href="/products/<%= bid.product_id %>"><%= bid.title %></a></td><td>Nu. <%= bid.amount %></td><td><%= bid.highest_bid_id===bid.id?'Highest bid':bid.status %></td><td><%= new Date(bid.created_at).toLocaleString('en-GB',{timeZone:'Asia/Thimphu'}) %></td></tr><% } %></tbody></table><% if(!bids.length){ %><p class="p-4 mb-0">No bids yet. <a href="/auctions">Explore auctions</a>.</p><% } %></div><% } %>
<%- include('partials/footer') %>

<%- include('partials/header') %><section class="surface form-panel"><h1>Edit listing</h1><p>Changes require administrator approval again. Listings with bids or active transactions cannot be edited.</p><form method="post" action="/products/<%= product.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label for="title" class="form-label">Title</label><input class="form-control mb-3" id="title" name="title" value="<%= product.title %>" required minlength="3" maxlength="160">
<label for="description" class="form-label">Description</label><textarea class="form-control mb-3" id="description" name="description" required minlength="10" maxlength="10000"><%= product.description %></textarea>
<label for="categoryId" class="form-label">Category</label><select class="form-select mb-3" name="categoryId" id="categoryId"><% for(const c of categories){ %><option value="<%= c.id %>" <%= c.id===product.category_id?'selected':'' %>><%= c.name %></option><% } %></select>
<label class="form-label" for="condition">Condition</label><select class="form-select mb-3" id="condition" name="condition"><% for(const c of ['New','Like New','Good','Fair','Used']){ %><option <%= c===product.condition?'selected':'' %>><%= c %></option><% } %></select>
<label class="form-label" for="price">Price / starting price (Nu.)</label><input type="number" min="0.01" max="9999999999.99" step="0.01" id="price" name="price" class="form-control mb-3" value="<%= product.price %>" required>
<% if(auction){ %><label for="increment" class="form-label">Minimum increment (Nu.)</label><input class="form-control mb-3" name="increment" id="increment" type="number" min="0.01" step="0.01" value="<%= auction.minimum_increment %>" required><label for="startsAt" class="form-label">Starts (UTC)</label><input class="form-control mb-3" name="startsAt" id="startsAt" type="datetime-local" value="<%= new Date(auction.starts_at).toISOString().slice(0,16) %>" required data-utc><label for="endsAt" class="form-label">Ends (UTC)</label><input class="form-control mb-3" name="endsAt" id="endsAt" type="datetime-local" value="<%= new Date(auction.ends_at).toISOString().slice(0,16) %>" required data-utc><p class="form-help">These two fields use UTC. Your existing photos are preserved.</p><% } %>
<button class="btn btn-primary">Save and resubmit for review</button></form></section><script src="/assets/product.js" defer></script><%- include('partials/footer') %>

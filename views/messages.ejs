<%- include('partials/header') %><%- include('partials/workspace-nav') %><div class="page-heading"><h1>Messages</h1><p>Arrange collection, ask questions and keep payment details private.</p></div>
<div class="message-layout"><aside class="surface p-3"><h2 class="h5">Conversations</h2><% if(!conversations.length){ %><p>No conversations yet. Open a listing and choose Contact seller.</p><a href="/marketplace">Find an item</a><% } %><% for(const c of conversations){const read=c.readAt?.[currentUser.id];const unread=c.lastMessageAt&&(!read||new Date(c.lastMessageAt)>new Date(read)); %><a class="conversation-link" href="/messages/<%= c._id %>"><%= c.people %><% if(unread){ %> <span class="status-badge">Unread</span><% } %><span class="small d-block"><%= new Date(c.updatedAt).toLocaleString() %></span></a><% } %></aside>
<section class="surface p-4"><% if(selected){ %><a href="/products/<%= selected.productId %>">View related product</a><div id="message-list" class="message-list" data-conversation="<%= selected._id %>"><% for(const message of messages){ %><article class="message-bubble <%= message.senderId===currentUser.id?'own':'' %>"><strong><%= message.senderId===currentUser.id?'You':'Student' %></strong><p><%= message.body %></p><time><%= new Date(message.createdAt).toLocaleString() %></time></article><% } %></div><div id="message-status" role="status" aria-live="polite"></div><form id="message-form" action="/messages/<%= selected._id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="message-body" class="form-label">Your message</label><textarea class="form-control mb-3" name="body" id="message-body" required maxlength="4000"></textarea><button class="btn btn-primary">Send message</button></form><% }else{ %><h2 class="h5">A conversation starts with a question.</h2><p>Select a conversation or contact a seller from a listing.</p><% } %></section></div>
<script src="/socket.io/socket.io.js" defer></script><script src="/assets/messages.js" defer></script><%- include('partials/footer') %>

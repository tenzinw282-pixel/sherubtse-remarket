<%- include('partials/header') %><%- include('partials/workspace-nav') %><div class="section-title"><h1>Notifications</h1><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">Mark all read (<%= unread %>)</button></form></div>
<% if(!notifications.length){ %><div class="surface empty-state"><h2 class="h5">You're all caught up.</h2><p>Listing decisions, bids, purchases and messages will appear here.</p></div><% } %>
<% for(const notice of notifications){ %><article class="surface p-4 mb-3"><% if(!notice.readAt){ %><span class="status-badge">Unread</span><% } %><p class="mt-2"><%= notice.text %></p><p class="small text-secondary"><%= new Date(notice.createdAt).toLocaleString() %></p><div class="button-row"><% if(notice.link){ %><a href="<%= notice.link %>">View details</a><% } %><% if(!notice.readAt){ %><form method="post" action="/notifications/<%= notice._id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">Mark read</button></form><% } %></div></article><% } %><%- include('partials/footer') %>

<div class="password-field mb-3">
  <input class="form-control" id="<%= id %>" name="<%= id %>" type="password" autocomplete="<%= autocomplete %>" required <% if(typeof registration!=='undefined' && registration){ %>minlength="12" maxlength="72"<% } %>>
  <button class="password-toggle" type="button" data-password-toggle data-password-label="<%= label %>" aria-label="Show <%= label %>" aria-controls="<%= id %>" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button>
</div>

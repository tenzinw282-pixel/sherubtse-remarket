<% if (products.length) { %><div class="listing-grid"><% for(const item of products) { %>
<article class="surface listing-card"><a href="/products/<%= item.id %>" class="listing-photo"><% if(item.image){ %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" width="480" height="360"><% }else{ %><span class="photo-placeholder"><i class="bi bi-image" aria-hidden="true"></i><span>No photo</span></span><% } %></a>
<div class="listing-body"><div class="d-flex justify-content-between gap-2"><span class="status-badge"><%= item.selling_type==='auction'?'Auction':item.condition %></span><span class="small text-secondary"><%= item.category_name %></span></div><h3 class="mt-3"><a href="/products/<%= item.id %>"><%= item.title %></a></h3><p class="listing-price">Nu. <%= item.current_price || item.price %></p><p class="small text-secondary mb-0">By <%= item.seller_name %></p></div></article>
<% } %></div><% }else{ %><div class="empty-state surface"><i class="bi bi-box-seam" aria-hidden="true"></i><h3>No listings here yet</h3><p>Approved student listings will appear here. Have something useful to pass on?</p><a class="btn btn-outline-secondary" href="/sell">List an item</a></div><% } %>

<%- include('partials/header') %>
<section class="surface content-panel"><div class="button-row"><span class="status-badge"><%= product.condition %></span><span class="status-badge"><%= product.selling_type==='auction'?'Auction':'Fixed price' %></span><span class="status-badge"><%= product.status %></span></div><h1 class="mt-3"><%= product.title %></h1><p class="product-price">Nu. <%= product.current_price || product.price %></p>
<% if(product.moderation_status!=='approved'){ %><div class="alert alert-info">Review status: <strong><%= product.moderation_status %></strong>. This listing is hidden from public browsing and cannot receive purchases or bids.<% if(product.moderation_reason){ %><p class="mb-0"><%= product.moderation_reason %></p><% } %></div><% } %>
<% if(reported){ %><p class="alert alert-success" role="status">Your report has been sent to the moderation team.</p><% } %>
<div class="product-gallery mb-4"><% if(photos.length){ %><img id="gallery-main" src="<%= photos[0].secure_url %>" alt="<%= product.title %>" width="800" height="800"><div class="image-previews mt-3"><% for(const [i,photo] of photos.entries()){ %><button type="button" class="gallery-thumb" data-photo="<%= photo.secure_url %>" aria-label="Show photo <%= i+1 %>"><img src="<%= photo.secure_url %>" alt="" width="80" height="80" loading="lazy"></button><% } %></div><% } %></div>
<h2 class="h5">About this item</h2><p class="text-break preserve-lines"><%= product.description %></p><p>Listed by <a href="/users/<%= product.seller_id %>"><%= product.seller_name %></a></p><% if(product.created_at){ %><p class="small text-secondary">Listed <%= new Date(product.created_at).toLocaleDateString('en-GB',{timeZone:'Asia/Thimphu'}) %></p><% } %>
<% if(currentUser){ %><div class="button-row mb-4">
<form method="post" action="/products/<%= product.id %>/favorite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary"><i class="bi bi-heart" aria-hidden="true"></i> <%= favorite?'Remove favorite':'Save favorite' %></button></form>
<% if(currentUser.id===product.seller_id){ %><a class="btn btn-primary" href="/products/<%= product.id %>/edit">Edit listing</a><% }else{ %><form method="post" action="/products/<%= product.id %>/contact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">Contact seller</button></form>
<% if(product.selling_type==='fixed'&&product.status==='available'&&product.moderation_status==='approved'){ %><form method="post" action="/products/<%= product.id %>/buy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary">Buy now &mdash; Nu. <%= product.price %></button></form><% } %><% } %></div><% }else{ %><p><a href="/login">Log in</a> to buy, bid, save favorites or contact this seller.</p><% } %>
<% if(auction){ %><section id="auction-panel" data-auction="<%= auction.id %>" data-auth="<%= !!currentUser %>" class="auction-panel"><h2>Live auction</h2><p class="small">Starting price: Nu. <%= auction.starting_price %> &middot; Increment: Nu. <%= auction.minimum_increment %></p>
<div class="stat-grid"><div><span>Current highest bid</span><strong id="current-bid">Nu. <%= product.current_price %></strong></div><div><span>Time remaining</span><strong id="auction-countdown">Connecting…</strong></div><div><span>Bid count</span><strong id="bid-count">0</strong></div></div>
<p id="bid-status" role="status" aria-live="polite"></p>
<% if(currentUser&&currentUser.id!==product.seller_id&&product.moderation_status==='approved'){ %><form id="bid-form" action="/auctions/<%= auction.id %>/bids" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="bid-amount">Your bid (Nu.)</label><div class="button-row"><input type="number" name="amount" id="bid-amount" class="form-control bid-input" min="0.01" step="0.01" max="9999999999.99" required><button class="btn btn-primary">Place bid</button></div></form><% } %>
<h3 class="mt-4">Bidding history</h3><div class="table-responsive"><table class="table"><thead><tr><th>Bidder</th><th>Amount</th><th>Time (your timezone)</th></tr></thead><tbody id="bid-history"></tbody></table></div></section><% } %>
<% if(currentUser){ %><details class="mt-4"><summary>Report a problem with this listing</summary><form class="mt-3" method="post" action="/products/<%= product.id %>/report"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="report-reason" class="form-label">Describe the issue (fraud, harassment, prohibited content or suspicious bidding)</label><textarea class="form-control mb-3" id="report-reason" name="reason" minlength="5" maxlength="2000" required></textarea><button class="btn btn-outline-secondary">Send report</button></form></details><% } %>
</section>
<script src="/assets/product.js" defer></script><% if(auction){ %><script src="/socket.io/socket.io.js" defer></script><script src="/assets/auction.js" defer></script><% } %>
<%- include('partials/footer') %>

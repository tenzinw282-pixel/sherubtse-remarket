<%- include('partials/header') %>
<section class="col-lg-6 mx-auto"><h1>Verify your email</h1>
<p>Enter the six-digit code emailed to you. It expires after five minutes. Each new code replaces the previous code.</p>
<% if (message) { %><div class="alert alert-info" role="status"><%= message %></div><% } %>
<form method="post" action="/verify-email"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label for="code" class="form-label">Verification code</label>
<input class="form-control mb-3" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code">
<button class="btn btn-primary">Verify email</button></form>
<form class="mt-3" method="post" action="/verify-email/resend"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary">Resend code</button></form>
<p class="mt-3">Wait 60 seconds between requests. Check spam and junk folders. Maximum five codes per hour.</p>
</section><%- include('partials/footer') %>
